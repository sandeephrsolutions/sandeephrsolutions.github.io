rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Candidate profile: candidate can access only their own document;
    // the configured admin UID can manage all candidate profiles.
    match /candidates/{userId} {
      allow read, create, update, delete:
        if request.auth != null
        && (
          request.auth.uid == userId
          || request.auth.uid == "A5y0cl3ZvRdlzFgDuQsYUjVCeNq2"
        );
    }

    // Published jobs are public. Only the configured admin UID can manage jobs.
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete:
        if request.auth != null
        && request.auth.uid == "A5y0cl3ZvRdlzFgDuQsYUjVCeNq2";
    }

    // A candidate may create an application only for their own UID.
    // A candidate may read only their own applications.
    // The configured admin UID can manage all applications.
    match /applications/{applicationId} {
      allow create:
        if request.auth != null
        && request.resource.data.candidateId == request.auth.uid;

      allow read:
        if request.auth != null
        && (
          request.resource.data.candidateId == request.auth.uid
          || request.auth.uid == "A5y0cl3ZvRdlzFgDuQsYUjVCeNq2"
        );

      allow update, delete:
        if request.auth != null
        && request.auth.uid == "A5y0cl3ZvRdlzFgDuQsYUjVCeNq2";
    }

    // Employer enquiries must remain publicly creatable because the public
    // employer form accepts submissions without an account. Read/update/delete
    // remain restricted to the configured admin UID.
    match /jobRequests/{requestId} {
      allow create: if true;
      allow read, update, delete:
        if request.auth != null
        && request.auth.uid == "A5y0cl3ZvRdlzFgDuQsYUjVCeNq2";
    }

    // Preserve the existing employer-record workflow while restricting access.
    match /employers/{employerId} {
      allow create: if true;
      allow read, update, delete:
        if request.auth != null
        && request.auth.uid == "A5y0cl3ZvRdlzFgDuQsYUjVCeNq2";
    }
  }
}
